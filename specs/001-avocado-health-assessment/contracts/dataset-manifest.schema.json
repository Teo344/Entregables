{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avocadoia.local/schemas/dataset-manifest.schema.json",
  "title": "AvocadoIA dataset manifest row",
  "description": "Schema for one source image and its verified project labeling and split assignment.",
  "type": "object",
  "required": [
    "image_id",
    "source_id",
    "original_path",
    "original_filename",
    "sha256",
    "review_status"
  ],
  "properties": {
    "image_id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "original_path": { "type": "string", "minLength": 1 },
    "original_filename": { "type": "string", "minLength": 1 },
    "working_path": { "type": ["string", "null"] },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "specimen_group_id": { "type": ["string", "null"] },
    "capture_session_id": { "type": ["string", "null"] },
    "source_label": { "type": ["string", "null"] },
    "project_class": {
      "type": ["string", "null"],
      "enum": ["healthy", "anthracnose", "peduncle_ring_compatible", null]
    },
    "review_status": {
      "type": "string",
      "enum": ["pending", "accepted", "excluded", "quarantined"]
    },
    "reviewer_role": { "type": ["string", "null"] },
    "review_criteria_version": { "type": ["string", "null"] },
    "review_note": { "type": ["string", "null"] },
    "split": {
      "type": ["string", "null"],
      "enum": ["train", "validation", "test", null]
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "review_status": { "const": "accepted" } }, "required": ["review_status"] },
      "then": {
        "properties": { "project_class": { "type": "string" } },
        "required": ["working_path", "project_class", "review_criteria_version"]
      }
    },
    {
      "if": { "properties": { "review_status": { "enum": ["pending", "excluded", "quarantined"] } }, "required": ["review_status"] },
      "then": { "properties": { "split": { "type": "null" } } }
    }
  ],
  "additionalProperties": false
}
