# Keep only the marker in the class folders; do not version their images or data.
/Modelo/AGUACATESANOS/*
!/Modelo/AGUACATESANOS/.gitkeep
/Modelo/ANTRACNOSIS/*
!/Modelo/ANTRACNOSIS/.gitkeep
/Modelo/PEDUNCULO/*
!/Modelo/PEDUNCULO/.gitkeep

# Ignore image files in PORCLASIFICAR, including nested folders.
/Modelo/PORCLASIFICAR/**/*.[jJ][pP][gG]
/Modelo/PORCLASIFICAR/**/*.[jJ][pP][eE][gG]
/Modelo/PORCLASIFICAR/**/*.[pP][nN][gG]
/Modelo/PORCLASIFICAR/**/*.[bB][mM][pP]
/Modelo/PORCLASIFICAR/**/*.[gG][iI][fF]
/Modelo/PORCLASIFICAR/**/*.[tT][iI][fF]
/Modelo/PORCLASIFICAR/**/*.[tT][iI][fF][fF]
/Modelo/PORCLASIFICAR/**/*.[wW][eE][bB][pP]
/Modelo/PORCLASIFICAR/**/*.[hH][eE][iI][cC]
/Modelo/PORCLASIFICAR/**/*.[aA][vV][iI][fF]
/Modelo/PORCLASIFICAR/**/*.[jJ][fF][iI][fF]

Modelo/PORCLASIFICAR/Drive/*.zip

# Imágenes retiradas durante la curación; su registro se versiona en datos/curacion/.
/Modelo/RETIRADAS/

# Salida del pipeline (se regenera con `python -m avocadoia_datos todo`).
/Modelo/PROCESADO/

# Entorno de Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/



# speckit-metricas: estado de sesion local y salidas regenerables
metricas/
# ETL y EDA (spec 002): entorno de análisis, caché de representaciones y planillas en curso
.venv-ml/
/datos/eda/cache/
/datos/revision/**/*.xlsx
